# systemd *user* unit: keep the phone camera exposed on /dev/video10 whenever the
# phone is reachable. pc4l itself waits for the device and reconnects with backoff,
# so the unit simply stays running; nothing needs udev.
#
#   install -Dm644 contrib/systemd/pc4l.service ~/.config/systemd/user/pc4l.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now pc4l
#   journalctl --user -u pc4l -f
#
# Requires /dev/video10 to exist without escalation (see contrib/modprobe.d) and
# `pc4l` on PATH (`cargo install --path crates/pc4l` puts it in ~/.cargo/bin).
# Adjust ExecStart for --facing/--resolution/--bitrate/--connect as needed.
[Unit]
Description=Android phone camera as V4L2 webcam (phone-cam4linux)
After=default.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/pc4l --device /dev/video10 --resolution max
Restart=always
RestartSec=5
# The scrcpy server jar is written to $TMPDIR before `adb push`.
PrivateTmp=yes
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
