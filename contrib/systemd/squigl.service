# systemd *user* unit: keep the phone camera exposed on /dev/video10 whenever the
# phone is reachable. squigl-cli itself waits for the device and reconnects with
# backoff, so the unit simply stays running; nothing needs udev.
#
#   install -Dm644 contrib/systemd/squigl.service ~/.config/systemd/user/squigl.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now squigl
#   journalctl --user -u squigl -f
#
# Requires /dev/video10 to exist without escalation (see contrib/modprobe.d) and
# `squigl-cli` on PATH (`cargo install --path crates/squigl-cli` puts it in ~/.cargo/bin).
# Adjust ExecStart for --facing/--resolution/--bitrate/--connect as needed.
[Unit]
Description=Android phone camera as V4L2 webcam (Squigl)

[Service]
Type=simple
ExecStart=%h/.cargo/bin/squigl-cli --device /dev/video10 --resolution max
Restart=always
RestartSec=5
# The scrcpy server jar is written to $TMPDIR before `adb push`.
PrivateTmp=yes
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
